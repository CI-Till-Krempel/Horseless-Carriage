# For a fully local setup with no commercial LLM (self-hosted Ollama instead
# of Gemini/OpenAI/Anthropic), use .env.local.example + docker-compose.local.yaml
# instead of this file - see the README's "Running fully local" section.

# --- Provider API Keys ---
# Fill in the API keys for the LLM providers you want to use.
OPENAI_API_KEY="<your_openai_key>"
ANTHROPIC_API_KEY="<your_anthropic_key>"
GOOGLE_API_KEY="<your_google_key>"

# --- GitHub Authentication ---
# Choose ONE of the following methods. If both are provided, the GITHUB_TOKEN will be used.

# Method 1: Personal Access Token (Recommended for simplicity)
# A fine-grained personal access token with repo permissions.
GITHUB_TOKEN="<your_github_token>"

# Method 2: GitHub App (Recommended for production or team use)
# Credentials for a dedicated GitHub App identity.
GITHUB_APP_ID="<your_app_id>"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID="<your_installation_id>"


# --- LiteLLM Proxy Configuration ---
LITELLM_MASTER_KEY="<your_master_key>"
LITELLM_PROXY_API_BASE="http://litellm:4000"
LITELLM_PROXY_API_KEY="<any_value_or_master_key>"
DATABASE_URL="postgresql://llm_user:llm_password@db:5432/litellm_db"

# --- Network exposure (GH issue #239) ---
# By default, the LiteLLM proxy/UI (port 4000) and the ADK web UI (port
# 8000) are only bound to 127.0.0.1 on the host - neither has authentication
# in front of it beyond LITELLM_MASTER_KEY (which may not gate the LiteLLM
# /ui dashboard on every image version - see SECURITY.md). Set either of
# these to 0.0.0.0 only on a network you trust (e.g. a shared dev box/office
# LAN where every user is expected to reach the tool) - this is an explicit
# opt-in, not the default.
LITELLM_BIND_HOST="127.0.0.1"
AGENT_WEB_BIND_HOST="127.0.0.1"


# --- Project Configuration ---
GITHUB_REPO_URL="git@github.com:your-org/your-repo.git"
GITHUB_REPO_BRANCH="main"
# GitFlow integration branch feature-branch PRs merge into (see
# _develop_branch_name) - direct pushes to either this or GITHUB_REPO_BRANCH
# above are refused; only feature branches get pushed to directly.
GITHUB_DEVELOP_BRANCH="develop"

# How often watch_roadmap.py (see docs/RUNNING.md "Watch Mode") polls for new
# commits on GITHUB_DEVELOP_BRANCH / stories ready for the next pipeline stage.
# Entirely optional - only used if you actually run that script. Defaults to
# 300 (5 minutes) if unset or not a valid integer.
WATCH_POLL_INTERVAL_SECONDS=300

# Target state repository path on the HOST machine.
# This will be mounted into the agent container and used for all state operations.
STATE_REPO_PATH="../Horseless-Carriage-State"

# --- Agent Session Management ---
SESSION_ID="my-sprint"

# --- Logging & Configuration ---
# Log levels: debug, info, warning, error, critical
LOG_LEVEL="info"
# Separate, much noisier opt-in: LiteLLM's own raw request/response dump
# (full system prompt + tool schema list, printed 2-3x per call via
# several internal litellm code paths) - LOG_LEVEL=debug alone gives you
# full *application* debug logging without this. Set to 1/true/yes only
# when you actually need to see the exact payload sent to the model - a
# real CI run's log ballooned to 16 MB for a handful of calls with this on
# by default, none of it needed to diagnose that run's actual failure.
LITELLM_LOG_VERBOSE=""

# --- Git Configuration ---
GIT_USER_NAME="DevTeam"
GIT_USER_EMAIL="devteam@company.com"

# --- Sprint Budget & Resource Configuration ---
# Two limits, two different scopes - see docs/BUDGET.md:
# - SPRINT_TOKEN_BUDGET: PER-SPRINT allowance. Resets automatically at the
#   start of every new sprint (reset_sprint_budget) - a runaway sprint can't
#   permanently starve later ones, but this alone does not cap what a whole
#   multi-sprint engagement could spend.
# - TOTAL_USD_BUDGET: WHOLE-ENGAGEMENT ceiling. Never resets automatically -
#   enforced by the LiteLLM proxy against the shared scrum-sprint-budget
#   object, and is the real safety net against unexpected cloud costs for a
#   cloud-provider setup (Gemini/OpenAI/Anthropic). (Older name
#   SPRINT_USD_BUDGET is still honored if TOTAL_USD_BUDGET is unset, but is
#   deprecated - the "SPRINT_" prefix was misleading given this never resets
#   per sprint like SPRINT_TOKEN_BUDGET does.)
# Running fully local (Ollama, .env.local.example) instead? TOTAL_USD_BUDGET
# does not apply there - a self-hosted model has no real per-token price, so
# LiteLLM's spend for it is always ~$0 regardless of usage (see ISSUE-0033);
# SPRINT_TOKEN_BUDGET is your only real guardrail in that mode.
# GH issue #220: a real "product mode" test-drive hard-halted before Dev/QA
# ever got a turn - planning alone (Orchestrator setup + PO backlog import +
# start of Architect) already used just over 1,000,000 tokens. Raised from
# 1,000,000 to 5,000,000 to match EVAL_SPRINT_TOKEN_BUDGET below, which
# already reflects the maintainers' own real-sprint experience.
SPRINT_TOKEN_BUDGET=5000000
TOTAL_USD_BUDGET=0.50
PROCESS_OVERHEAD_PERCENTAGE=20

# How much EXTRA token/USD budget (as a percentage of the main sprint
# ceiling) ScrumMaster/ProductOwner/QualityGuardian/ScrumOrchestrator may
# still spend, combined, after the main budget is exhausted - specifically
# to finish the SPRINT CLOSE SEQUENCE (retro -> create_sprint_report ->
# KPIs -> create_release_pr) for real, rather than skipping it entirely
# (see agents/scrum_team/helpers.py:closeout_grace_percent, ISSUE-0046).
# DevTeam/QA/Architect get none of this grace (aside from a one-time
# reserved turn each if they haven't had one yet this sprint - GH issue
# #220, agents/scrum_team/helpers.py:NON_GRACE_FLOOR_ROLES). This value is
# also the ceiling before scaling: closeout_grace_percent(state) scales it
# down as less of the close-out sequence remains outstanding, so a fully-
# exhausted call made once only the release PR is left gets a smaller
# allowance than one made with the whole sequence still ahead of it.
# Defaults to 20.0 (20%) if unset.
SPRINT_CLOSEOUT_GRACE_PERCENT=20.0

# --- Sprint Shape Configuration ---
# Sizing knobs for the Ready-backlog sufficiency gate (see
# agents/scrum_team/helpers.py:ready_backlog_shortfall) that
# create_sprint_backlog_pr enforces before Dev Team may start implementing -
# the Ready backlog must hold at least TARGET_STORIES_PER_SPRINT x
# READY_BACKLOG_SPRINTS_TARGET stories.
# How many stories a sprint is assumed to get through - a deliberately
# simple, round-number assumption, not a measured velocity. Defaults to 3.
TARGET_STORIES_PER_SPRINT=3
# How many sprints' worth of Ready work the backlog should hold before
# Dev Team may start implementing. Defaults to 2.
READY_BACKLOG_SPRINTS_TARGET=2

# --- Human Interaction Level ---
# Controls how much of a human is actually in the loop, and which
# human-approval gate (if any) is mechanically required before the team may
# implement stories / release an increment - see docs/INTERACTION-LEVELS.md.
# One of: Product | Stakeholder | CEO | EVAL. Defaults to "Product" (the
# most-supervised level) if unset or unrecognized.
INTERACTION_LEVEL="Product"

# --- Blocking Interaction Notifications ---
# Which notifier plugin(s) fire when the team records a blocking
# interaction - an "absolutely necessary human feedback" moment (e.g. a
# release PR blocked on a missing human approval) or a critical tool error
# (e.g. the sprint budget was exhausted) - so it doesn't go unnoticed
# during an unsupervised run. Comma-separated names from
# agents/scrum_team/tools/notifications.py's NOTIFIER_REGISTRY; unknown
# names are skipped with a warning. Defaults to "console" (prints a
# hard-to-miss banner to the agent container's logs) if unset - always
# available, no further configuration needed. New integrations (Slack,
# email, a webhook) are added by writing a new Notifier subclass and
# registering it there - see docs/NOTIFICATIONS.md.
NOTIFICATION_PLUGINS="console"

# --- Conversation Transcript ---
# Max entries kept in the shared multi-agent transcript (state.transcript)
# before older ones are trimmed. Defaults to 200 if unset.
TRANSCRIPT_MAX_ENTRIES=200

# --- Eval Harness Budget Configuration ---
# Per-sprint budgets for agents/scrum_team/scripts/run_eval.py (the automated
# team-performance eval harness - see RELEASE.md "Team performance
# evaluation"), NOT scaled the same way:
# - EVAL_SPRINT_TOKEN_BUDGET: used as-is, per sprint (token_usage resets at
#   the start of every sprint - see run_eval.py's _run_one_sprint). GH issue
#   #81: a real run's later, more complex sprints used up to ~2.8M tokens -
#   2,600,000 was too tight and truncated sprints 4-5 with a
#   TOKEN BUDGET EXCEEDED halt. Bumped with real headroom above that; then
#   ISSUE-0045: 0.1.0-run25 hit 4,072,826 in sprint 1 alone, bumped again.
# - EVAL_USD_BUDGET_PER_SPRINT: a *rate* multiplied by --sprints into the
#   run's whole-engagement TOTAL_USD_BUDGET (older name EVAL_SPRINT_USD_BUDGET
#   still honored as a deprecated fallback).
EVAL_SPRINT_TOKEN_BUDGET=5000000
EVAL_USD_BUDGET_PER_SPRINT=3.0