# --- Provider API Keys ---
# Fill in the API keys for the LLM providers you want to use.
OPENAI_API_KEY="<your_openai_key>"
ANTHROPIC_API_KEY="<your_anthropic_key>"
GOOGLE_API_KEY="<your_google_key>"

# --- GitHub Authentication ---
# Choose ONE of the following methods. If both are provided, the GITHUB_TOKEN will be used.

# Method 1: Personal Access Token (Recommended for simplicity)
# A fine-grained personal access token with repo permissions.
GITHUB_TOKEN="<your_github_token>"

# Method 2: GitHub App (Recommended for production or team use)
# Credentials for a dedicated GitHub App identity.
GITHUB_APP_ID="<your_app_id>"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID="<your_installation_id>"


# --- LiteLLM Proxy Configuration ---
LITELLM_MASTER_KEY="<your_master_key>"
LITELLM_PROXY_API_BASE="http://litellm:4000"
LITELLM_PROXY_API_KEY="<any_value_or_master_key>"
DATABASE_URL="postgresql://llm_user:llm_password@db:5432/litellm_db"


# --- Project Configuration ---
GITHUB_REPO_URL="git@github.com:your-org/your-repo.git"
GITHUB_REPO_BRANCH="main"

# Target state repository path on the HOST machine. 
# This will be mounted into the agent container and used for all state operations.
STATE_REPO_PATH="../Horseless-Carriage-State"

# --- Agent Session Management ---
SESSION_ID="my-sprint"

# --- Logging & Configuration ---
# Log levels: debug, info, warning, error, critical
LOG_LEVEL="info"

# --- Git Configuration ---
GIT_USER_NAME="DevTeam"
GIT_USER_EMAIL="devteam@company.com"

# --- Sprint Budget & Resource Configuration ---
SPRINT_TOKEN_BUDGET=1000000
SPRINT_USD_BUDGET=0.50
PROCESS_OVERHEAD_PERCENTAGE=20

# --- Eval Harness Budget Configuration ---
# Per-sprint budget for agents/scrum_team/scripts/run_eval.py (the automated
# team-performance eval harness - see RELEASE.md "Team performance
# evaluation"). Multiplied by --sprints, since SPRINT_TOKEN_BUDGET/
# SPRINT_USD_BUDGET above are cumulative for the whole run rather than
# resetting per sprint.
EVAL_SPRINT_TOKEN_BUDGET=2600000
EVAL_SPRINT_USD_BUDGET=3.0