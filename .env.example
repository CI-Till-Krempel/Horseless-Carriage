# Provider API keys (placeholders only; do not commit real secrets)
OPENAI_API_KEY="<your_openai_key>"
ANTHROPIC_API_KEY="<your_anthropic_key>"
GOOGLE_API_KEY="<your_google_key>"

# LiteLLM proxy configuration (optional)
LITELLM_PROXY_API_BASE="http://localhost:4000"
LITELLM_PROXY_API_KEY="<any_value_or_master_key>"

# --- LiteLLM Database ---
DATABASE_URL="postgresql://llm_user:llm_password@db:5432/litellm_db"

# --- GitHub App Setup ---
GITHUB_APP_ID="<your_app_id>"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID="<your_installation_id>"

# --- Scrum Team Non-Interactive Setup ---
GITHUB_REPO_URL="git@github.com:your-org/your-repo.git"
GITHUB_REPO_BRANCH="main"
GITHUB_REPO_LOCAL_PATH="./source/state_repo"

SPRINT_TOKEN_BUDGET=1000000
SPRINT_USD_BUDGET=0.50
