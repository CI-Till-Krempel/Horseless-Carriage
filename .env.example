# Provider API keys (placeholders only; do not commit real secrets)
OPENAI_API_KEY="<your_openai_key>"
ANTHROPIC_API_KEY="<your_anthropic_key>"
GOOGLE_API_KEY="<your_google_key>"

# LiteLLM proxy configuration (optional)
LITELLM_PROXY_API_BASE="http://localhost:4000"
LITELLM_PROXY_API_KEY="<any_value_or_master_key>"

# GitHub integration (used by automation/scripts; placeholders only)
GITHUB_OWNER="<org_or_username>"
GITHUB_REPO="<repo_name>"
GITHUB_TOKEN="<gh_pat_with_repo_scope>"
GIT_AUTHOR_NAME="<your_name>"
GIT_AUTHOR_EMAIL="<your_email@example.com>"

# Repository policy toggles (optional)
DEFAULT_BRANCH="main"
ENABLE_BRANCH_PROTECTION="true"
REQUIRE_SIGNED_COMMITS="false"
