.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

.idea/
.adk/
# GH issue #156: eval/adk/agent/scrum_team/.adk itself (not its contents -
# adk eval's own run-history writes there at runtime, into a writable
# named volume mounted over this path - see docker-compose.yaml) must
# exist on the host before the container starts, since Docker can't
# create a volume's mountpoint directory inside an already-read-only bind
# mount (./eval:/app/eval:ro). Keeping just a placeholder tracked, same
# convention as /sessions/placeholder.txt below, is enough - the volume's
# actual contents are never this repo checkout's.
!eval/adk/agent/scrum_team/.adk/
!eval/adk/agent/scrum_team/.adk/.gitkeep
/sessions/adk_sessions.db
# ADK session files can contain real conversation content (tool args/
# results, pasted secrets) - never track them. placeholder.txt is kept
# tracked on purpose, just to keep the directory present in git.
/sessions/*.session.json
# Scratch space for the eval harness's local eval-repo clone + generated
# report/manifest (see docker-compose.yaml, .github/workflows/eval.yml).
/eval-output/

# This repo is the tool's own source, not a target/state repo - .hc/state.json
# should only ever exist in a *configured* state repo. Some tests build a
# tool_context whose state doesn't set repo.local_path/STATE_REPO_PATH, so
# _configured_repo_root() falls back to the project root and writes real
# fixture data here - never track that leakage.
.hc/

.DS_Store
