# Local-only environment template - no commercial LLM provider keys needed.
# Use with:
#   cp .env.local.example .env
#   docker compose -f docker-compose.local.yaml up
# See config/model-templates/litellm.local-ollama.yaml for the model mapping.

# --- Ollama ---
# Model tag pulled automatically on first start (see ollama-entrypoint.sh).
# Must match the `model:` value in config/model-templates/litellm.local-ollama.yaml
# (without the "ollama/" prefix). Pick based on your hardware:
#   llama3.2:3b   - CPU-only / ~8GB RAM
#   llama3.1:8b   - default, ~16GB RAM or any modern GPU
#   qwen2.5:14b   - 24GB+ VRAM
OLLAMA_MODEL="llama3.1:8b"

# How long an idle model stays loaded in memory before Ollama unloads it
# (Ollama's own default is 5m). This container serves one model to this one
# team continuously, so -1 (never unload) avoids paying the full load time
# again on every request after a few minutes of idle time - see
# docker-compose.local.yaml's `ollama` service and docs/SETUP.md's
# "Performance Tuning" section. Only lower this if you're sharing
# this Ollama instance for other, bursty workloads too.
OLLAMA_KEEP_ALIVE="-1"

# Whether to merge in docker-compose.gpu.yaml (NVIDIA GPU passthrough) when
# starting the ollama service - see docs/SETUP.md's "GPU Support" section
# for prerequisites. Set interactively by setup_llm.py, which detects a
# usable NVIDIA GPU via nvidia-smi and recommends "true" if one is found;
# only set this manually if you're skipping that prompt.
OLLAMA_GPU_ENABLED="false"

# --- GitHub Authentication ---
# Choose ONE of the following methods. If both are provided, the GITHUB_TOKEN will be used.

# Method 1: Personal Access Token (Recommended for simplicity)
# A fine-grained personal access token with repo permissions.
GITHUB_TOKEN="<your_github_token>"

# Method 2: GitHub App (Recommended for production or team use)
# Credentials for a dedicated GitHub App identity.
GITHUB_APP_ID="<your_app_id>"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID="<your_installation_id>"


# --- LiteLLM Proxy Configuration ---
# These secure the self-hosted proxy itself - not a commercial API key.
LITELLM_MASTER_KEY="<your_master_key>"
LITELLM_PROXY_API_BASE="http://litellm:4000"
LITELLM_PROXY_API_KEY="<any_value_or_master_key>"
DATABASE_URL="postgresql://llm_user:llm_password@db:5432/litellm_db"


# --- Project Configuration ---
GITHUB_REPO_URL="git@github.com:your-org/your-repo.git"
GITHUB_REPO_BRANCH="main"
# GitFlow integration branch feature-branch PRs merge into (see
# _develop_branch_name) - direct pushes to either this or GITHUB_REPO_BRANCH
# above are refused; only feature branches get pushed to directly.
GITHUB_DEVELOP_BRANCH="develop"

# Target state repository path on the HOST machine.
# This will be mounted into the agent container and used for all state operations.
STATE_REPO_PATH="../Horseless-Carriage-State"

# --- Agent Session Management ---
SESSION_ID="my-sprint"

# --- Logging & Configuration ---
# Log levels: debug, info, warning, error, critical
LOG_LEVEL="info"

# --- Git Configuration ---
GIT_USER_NAME="DevTeam"
GIT_USER_EMAIL="devteam@company.com"

# --- Sprint Budget & Resource Configuration ---
# Ollama has no per-token cost, so USD spend will report as ~$0 regardless of
# these values; the token budget still applies.
SPRINT_TOKEN_BUDGET=1000000
SPRINT_USD_BUDGET=0.50
PROCESS_OVERHEAD_PERCENTAGE=20

# --- Human Interaction Level ---
# Controls how much of a human is actually in the loop, and which
# human-approval gate (if any) is mechanically required before the team may
# implement stories / release an increment - see docs/INTERACTION-LEVELS.md.
# One of: Product | Stakeholder | CEO | EVAL. Defaults to "Product" (the
# most-supervised level) if unset or unrecognized.
INTERACTION_LEVEL="Product"

# --- Eval Harness Budget Configuration ---
# Per-sprint budget for agents/scrum_team/scripts/run_eval.py (the automated
# team-performance eval harness - see RELEASE.md "Team performance
# evaluation"). Multiplied by --sprints, since SPRINT_TOKEN_BUDGET/
# SPRINT_USD_BUDGET above are cumulative for the whole run rather than
# resetting per sprint.
EVAL_SPRINT_TOKEN_BUDGET=2600000
EVAL_SPRINT_USD_BUDGET=3.0
